# Jetstark Backend Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://jetstark:changeme@localhost:5432/jetstark
DATABASE_URL_SYNC=postgresql://jetstark:changeme@localhost:5432/jetstark

# Security — generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Redis (optional — session cache)
REDIS_URL=redis://localhost:6379/0

# Paystack (https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (for welcome emails, password reset)
# Use Mailtrap.io for testing, SendGrid/Mailgun for production
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@jetstark.com

# Application
APP_NAME=Jetstark Affiliate Hub
DEBUG=true

# Uploads directory — defaults to ./uploads/ locally
# For Render: set to the persistent disk mount path, e.g. /opt/render/project/uploads
UPLOAD_DIR=uploads

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8000,http://localhost:5500,http://127.0.0.1:5500

# Sentry (https://sentry.io/settings/account/api/)
SENTRY_DSN=
